# Photo upload (Milestone A slice 4): must use the madisonultimate@gmail.com OAuth identity,
# not the service account (service accounts cannot create Drive files). Reuse the same
# refresh token minted for madison-ultimate-admin/finalforms-export if you already have one.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
PHOTOS_FOLDER_ID=

# On-demand Final Forms refresh (Milestone B slice 8): a GitHub token with `workflow` scope
# for triggering workflow_dispatch on madison-ultimate-admin's finalforms-export workflow.
# Also needs a concurrency group added to that workflow file so overlapping runs queue
# instead of racing; the refresh route works without these but reports itself unconfigured.
FINALFORMS_GITHUB_TOKEN=
FINALFORMS_GITHUB_REPO=
FINALFORMS_GITHUB_WORKFLOW_FILE=
FINALFORMS_GITHUB_REF=main

# Buttondown (optional): API key for mailing list status on player page
# Get your key at https://buttondown.com/requests — see AUTHENTICATION_SETUP.md
# BUTTONDOWN_API_KEY=